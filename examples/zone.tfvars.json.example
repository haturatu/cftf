{
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "zone": {
    "id": "REPLACE_WITH_ZONE_ID",
    "name": "example.invalid",
    "type": "full",
    "paused": false
  },
  "dns_records": {},
  "origin_cloud_regions": {
    "primary_origin": {
      "origin_ip": "203.0.113.10",
      "vendor": "oci",
      "region": "ap-tokyo-1"
    }
  },
  "origin_ca_certificates": {},
  "settings": {},
  "rulesets": {
    "global_rate_limit": {
      "name": "Global HTTP Rate Limit",
      "description": "IP-based limit for all HTTP traffic",
      "kind": "zone",
      "phase": "http_ratelimit",
      "rules_json": "[{\"ref\":\"global_ip_rate_limit\",\"description\":\"Limit all HTTP requests per IP\",\"expression\":\"true\",\"action\":\"block\",\"enabled\":true,\"ratelimit\":{\"characteristics\":[\"cf.colo.id\",\"ip.src\"],\"period\":10,\"requests_per_period\":30,\"mitigation_timeout\":10}}]"
    },
    "public_assets_cache_response": {
      "id": null,
      "name": "Public Asset Cache Response",
      "description": "Set browser and edge cache lifetimes for public assets",
      "kind": "zone",
      "phase": "http_response_cache_settings",
      "rules_json": "[{\"ref\":\"public_assets_cache_control\",\"description\":\"Set browser and edge cache lifetimes for public assets\",\"expression\":\"http.host eq \\\"assets.example.invalid\\\" and starts_with(http.request.uri.path, \\\"/assets/\\\") and http.response.code eq 200 and not (http.response.headers[\\\"cache-control\\\"][0] contains \\\"immutable\\\")\",\"action\":\"set_cache_control\",\"action_parameters\":{\"max-age\":{\"operation\":\"set\",\"value\":300},\"s-maxage\":{\"operation\":\"set\",\"value\":86400,\"cloudflare_only\":true}},\"enabled\":true}]"
    }
  },
  "managed_entrypoints": {},
  "web_baseline": {
    "dnssec": false,
    "url_normalization": false
  },
  "bot_management": {
    "fight_mode": true,
    "ai_bots_protection": "block",
    "crawler_protection": "enabled",
    "is_robots_txt_managed": true,
    "bot_preference_sync_enabled": true
  },
  "url_normalization": null,
  "dnssec": {
    "status": "active"
  },
  "managed_transforms": {
    "request_headers": [
      {
        "id": "add_waf_credential_check_status_header",
        "enabled": true
      }
    ],
    "response_headers": [
      {
        "id": "add_security_headers",
        "enabled": true
      },
      {
        "id": "remove_x-powered-by_header",
        "enabled": true
      }
    ]
  },
  "leaked_credential_check": true,
  "authenticated_origin_pulls": false,
  "access_rules": {},
  "user_agent_blocking_rules": {}
}
