# Cloudflare provider and R2 backend authentication. Copy to .env and set local values.
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private R2 configuration revision used by the trusted operator runner.
R2_CONFIG_ACCESS_KEY_ID=
R2_CONFIG_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_CONFIG_BUCKET=
CONFIG_REVISION=
CONFIG_MANIFEST_SHA256=

# Existing application credentials are kept local and are not Terraform inputs.
CF_SERCRET_KEY=
CF_S3_ENDPOINT=
APP_PASSWORD=
SESSION_SECRET=
