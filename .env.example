# Cloudflare provider and R2 backend authentication. Copy to .env and set local values.
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Existing application credentials are kept local and are not Terraform inputs.
CF_SERCRET_KEY=
CF_S3_ENDPOINT=
APP_PASSWORD=
SESSION_SECRET=
